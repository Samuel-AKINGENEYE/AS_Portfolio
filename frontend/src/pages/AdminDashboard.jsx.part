// Inside ProfileTab component, add this before the Name field:

<div>
  <label className={LABEL}>Profile Avatar</label>
  <div className="flex items-center gap-4">
    {form?.avatar && (
      <img src={form.avatar} alt="Avatar" className="w-16 h-16 rounded-full object-cover border-2 border-blue-500" />
    )}
    <input
      type="url"
      placeholder="https://your-image-url.com/avatar.jpg"
      value={form?.avatar || ''}
      onChange={(e) => set('avatar', e.target.value)}
      className={INPUT}
    />
  </div>
  <p className="text-xs text-slate-400 mt-1">Upload to Cloudinary or use any image URL</p>
</div>
