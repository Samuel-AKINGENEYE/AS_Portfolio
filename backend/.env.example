# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB — get a free cluster at mongodb.com/atlas
MONGODB_URI=mongodb://localhost:27017/portfolio

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Cloudinary (optional — leave blank to use local uploads folder instead)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by seed.js to create the initial admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Email notifications — contact form submissions are emailed here
# For Gmail: go to myaccount.google.com > Security > App Passwords, generate one
SMTP_SERVICE=gmail
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=your@gmail.com
